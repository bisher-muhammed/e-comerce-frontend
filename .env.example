# Copy to .env and fill in real values. Never commit .env.
#
# Every variable here is NEXT_PUBLIC_, which means it is inlined into the
# browser bundle at build time. Nothing secret belongs in this file.
#
# Because they are baked in at build time, changing one requires a
# rebuild — restarting the server is not enough.

# ── API ──────────────────────────────────────────────────────────────
# Base URL of the backend, including the version prefix. No trailing
# slash: every service path is appended directly to it.
#
# The browser sends auth cookies to this origin with credentials, so it
# must appear verbatim in the backend's CORS_ORIGINS allowlist. The admin
# portal is a separate origin and needs its own entry in that allowlist.
#
# Production: https://api.raviscort.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ── Site ─────────────────────────────────────────────────────────────
# Absolute origin this storefront is served from, used to build the
# canonical and Open Graph URLs in page metadata. Scheme and host only,
# no trailing slash and no path.
#
# Optional locally — it falls back to the production domain. Set it in
# any deployed environment, or previews will advertise production URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

#
CLOUDINARY_CLOUD_NAME=
